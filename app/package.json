{
  "name": "devops-challenge-app",
  "version": "1.0.0",
  "description": "Production-ready Node.js microservice for DevOps challenge",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit --detectOpenHandles --coverage",
    "test:ci": "jest --forceExit --detectOpenHandles --coverage --ci"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
